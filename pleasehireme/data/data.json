    "Solid State Tesla Coil": {
      "start": "6/21/22",
      "end": "9/22/22",
      "LOCATION": "College Station, TX",
      "DESCRIPTION": {
        "MAIN": "Created a 100 kilovolt {Tesla Coil}",
          "+Tesla Coil": "A {resonant transformer} that creates huge potential voltage differences until it arcs through the air",
            "+resonant transformer": "Tesla coils are a type of {LRC} circuit.",
              "+LRC": "LRC stands for {Inductor} (symbol L for Henries), R for {Resistor}, and C for {Capacitor}.",
              "+Inductor": "Inductors store magnetic energy, typically through tight windings of a wire. In this case, they are the winding neck of a tesla coil. Tesla coils have a {primary and secondary} inductor.",
                "+primary and secondary": "These two coils act together to increase the total voltage difference. The less windings on the primary and more windings on the secondary, the higher the voltage, with some other complicated rules added in.",
              "+Resistor": "Resistors are an electrical component that create a \"kink\" in a circuit, \"slowing\" down the net movement of electrons.",
              "+Capacitor": "An electrical tool to store charge between two plates. The two plates are physically separated, and in this case, the air works because of the high voltage that causes the air to break down."
      }
    }
